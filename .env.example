# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID="your_sanity_project_id"
NEXT_PUBLIC_SANITY_DATASET="production"

# Optional: application has a built-in default
# NEXT_PUBLIC_SANITY_API_VERSION="2026-09-27"

SANITY_API_WRITE_TOKEN="your_sanity_api_write_token"

# AI
GROQ_API_KEY="your_groq_api_key"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"

# Recommended for full Echo Shelf functionality
YOUTUBE_API_KEY="your_youtube_data_api_v3_key"
GNEWS_API_KEY="your_gnews_api_key"

# Optional — increases repository API limits / private repo support
# GITHUB_TOKEN="your_github_personal_access_token"
# GITLAB_TOKEN="your_gitlab_personal_access_token"