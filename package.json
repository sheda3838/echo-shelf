{
  "name": "echo-shelf",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed:connections": "tsx --env-file=.env.local scripts/seed-smart-connections.ts",
    "test:connections": "tsx --env-file=.env.local scripts/verify-smart-connections-shortlist.ts && tsx --env-file=.env.local scripts/verify-smart-connections-phase2b.ts",
    "test:clusters": "tsx --env-file=.env.local scripts/verify-knowledge-clusters.ts",
    "test:rediscovery": "tsx --env-file=.env.local scripts/verify-rediscovery.ts",
    "test:duplicates": "tsx --env-file=.env.local scripts/verify-duplicate-detection.ts",
    "test:auth": "tsx --env-file=.env.local scripts/verify-auth.ts",
    "test:isolation": "tsx --env-file=.env.local scripts/verify-user-isolation.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@sanity/icons": "^5.2.2",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^5.31.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@types/jszip": "^3.4.0",
    "groq-sdk": "^1.6.0",
    "jsdom": "^28.1.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "next": "16.3.6",
    "next-sanity": "^13.3.4",
    "pdf-parse": "^1.1.1",
    "pptx-text-parser": "^1.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "^5.31.2",
    "styled-components": "^6.5.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
